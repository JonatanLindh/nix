layout {
    tab hide_floating_panes=true {
        pane
        pane size=1 borderless=true {
            plugin location="zellij:compact-bar"
        }
        floating_panes {
            pane {
                x "0%"
                y "60%"
                width "100%"
                height "40%"
            }
        }
    }
}
